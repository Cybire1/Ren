# The Kova web app (mykova.app): the landing page, the dashboard, pay pages and stalls.
# Railway builds it with RAILWAY_DOCKERFILE_PATH=Dockerfile.web; the API uses ./Dockerfile.
FROM node:22-slim AS build
RUN corepack enable
# The image builds the shared packages it needs in its own step, not on install.
ENV KOVA_SKIP_PACKAGE_BUILD=1
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/monad/package.json packages/monad/
COPY packages/tempo/package.json packages/tempo/
RUN pnpm install --frozen-lockfile --filter "@kova/web..."
COPY tsconfig*.json ./
# The web signs the same payments as the app and the API, with the same chain packages.
COPY packages/monad packages/monad
COPY packages/tempo packages/tempo
# NEXT_PUBLIC_ settings are compiled into the pages, so they arrive at build time (Railway passes
# service variables as build arguments): which chain, and the domain passkeys belong to.
ARG NEXT_PUBLIC_KOVA_CHAIN
ARG NEXT_PUBLIC_KOVA_PASSKEY_DOMAIN
ENV NEXT_PUBLIC_KOVA_CHAIN=$NEXT_PUBLIC_KOVA_CHAIN NEXT_PUBLIC_KOVA_PASSKEY_DOMAIN=$NEXT_PUBLIC_KOVA_PASSKEY_DOMAIN
COPY apps/web apps/web
RUN pnpm --filter "@kova/web..." build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
