{
  "name": "kova",
  "private": true,
  "description": "Kova: a dollar wallet with your shop inside it, on Monad",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node -e \"if (process.env.KOVA_SKIP_PACKAGE_BUILD || !require('fs').existsSync('packages/monad/src')) process.exit(0); require('child_process').execSync(\\\"pnpm --filter './packages/*' build\\\", { stdio: 'inherit' })\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.56.8",
      "ox": "0.14.45"
    }
  }
}
