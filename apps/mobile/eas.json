{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "ren": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_KOVA_CHAIN": "tempo",
        "EXPO_PUBLIC_KOVA_TEMPO_WEB_URL": "https://web-production-acdb.up.railway.app",
        "EXPO_PUBLIC_KOVA_TEMPO_API_URL": "https://api-production-a594b.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "5N8DU2A9WH",
        "ascAppId": "6819066097"
      }
    },
    "ren": {
      "ios": {
        "appleTeamId": "R38YN743Q6",
        "ascAppId": "6834510897"
      }
    }
  }
}
