{
  "expo": {
    "name": "Ren",
    "slug": "kova",
    "scheme": "kova",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E8F7EF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.kova.pay.monad",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to approve payments and unlock your Ren wallet.",
        "NFCReaderUsageDescription": "Ren reads Ren Cards to link them to your wallet and to take card payments at your till.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight",
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      },
      "associatedDomains": [
        "webcredentials:mykova.app",
        "applinks:mykova.app",
        "webcredentials:web-monad.up.railway.app",
        "applinks:web-monad.up.railway.app"
      ],
      "appleTeamId": "R38YN743Q6"
    },
    "android": {
      "package": "xyz.kova.pay.monad",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-foreground.png",
        "backgroundColor": "#E8F7EF"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ren reads Ren Cards to link them to your wallet and to take card payments at your till.",
          "includeNdefEntitlement": false,
          "selectIdentifiers": [
            "A0000009490148614C6F",
            "481199130E9F01"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Ren uses the camera to scan payment codes and barcodes, and to photograph what you sell.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ren lets you pick photos of what you sell for your stall.",
          "cameraPermission": "Ren uses the camera to scan payment codes and barcodes, and to photograph what you sell.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#E8F7EF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png",
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "5ba42917-2a21-4f53-ac1f-cc3ab2c1f0e1"
      }
    },
    "owner": "shaibuafeez"
  }
}
