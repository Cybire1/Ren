{
  "expo": {
    "name": "Kova",
    "slug": "kova",
    "scheme": "kova",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E7E5E0",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.kova.pay.monad",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to approve payments and unlock your Kova wallet.",
        "NFCReaderUsageDescription": "Hold a Kova Card near the top of your iPhone to take a payment."
      },
      "associatedDomains": [
        "webcredentials:web-monad.up.railway.app",
        "applinks:web-monad.up.railway.app",
        "webcredentials:monad.mykova.app",
        "applinks:monad.mykova.app"
      ],
      "appleTeamId": "5N8DU2A9WH"
    },
    "android": {
      "package": "xyz.kova.pay.monad",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.NFC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-foreground.png",
        "backgroundColor": "#E7E5E0"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Hold a Kova Card near the top of your iPhone to take a payment.",
          "selectIdentifiers": [
            "F04B4F564131"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Kova uses the camera to scan payment codes and barcodes, and to photograph what you sell.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kova lets you pick photos of what you sell for your stall.",
          "cameraPermission": "Kova uses the camera to scan payment codes and barcodes, and to photograph what you sell.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#E7E5E0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png"
  }
}
