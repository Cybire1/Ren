# The Tempo build (the default) points at Ren's live API and website. Its passkeys, sign-in and
# shared links all belong to that website, so moving Ren to its own domain is this one line (with
# the web's NEXT_PUBLIC_KOVA_PASSKEY_DOMAIN and the API's KOVA_SIGN_IN_DOMAINS set to match):
# EXPO_PUBLIC_KOVA_TEMPO_WEB_URL=https://<Ren's domain>
# A local API instead (on a device, localhost is the device: use your Mac's LAN IP):
# EXPO_PUBLIC_KOVA_TEMPO_API_URL=http://localhost:4400
# The chain (tempo, the default, or monad), its network, and the passkey domain if it isn't the
# website's own host.
# EXPO_PUBLIC_KOVA_CHAIN=tempo
# EXPO_PUBLIC_KOVA_NETWORK=testnet
# EXPO_PUBLIC_KOVA_PASSKEY_DOMAIN=
# Private dollars: the zone (Tempo's testnet Zone A by default on Tempo testnet).
# EXPO_PUBLIC_KOVA_ZONE_ID=6
# EXPO_PUBLIC_KOVA_ZONE_CHAIN_ID=4217000006
# EXPO_PUBLIC_KOVA_ZONE_PORTAL=0x7069DeC4E64Fd07334A0933eDe836C17259c9B23
# EXPO_PUBLIC_KOVA_ZONE_OPERATOR=Tempo
# EXPO_PUBLIC_KOVA_ZONE_RUNTIME=sandbox
# EXPO_PUBLIC_KOVA_ZONE_RPC_URL=https://rpc-zone-a.testnet.tempo.xyz
# EXPO_PUBLIC_KOVA_ZONE_PROXY_URL=
#
# The Monad build points at Kova's Monad deployment and mykova.app by default. To use a local API
# instead (on a device, localhost is the device: use your Mac's LAN IP):
# EXPO_PUBLIC_KOVA_MONAD_API_URL=http://localhost:4000
# EXPO_PUBLIC_KOVA_MONAD_WEB_URL=http://localhost:3000
# Development only. A shipped terminal registers for a device token instead.
EXPO_PUBLIC_KOVA_API_KEY=kova_test_sk_...
