# Point the app at a Kova API. On a device, localhost is the device: use your Mac's LAN IP.
EXPO_PUBLIC_KOVA_API_URL=http://localhost:4000
EXPO_PUBLIC_KOVA_WEB_URL=http://localhost:3000
# Development only. A shipped terminal registers for a device token instead.
EXPO_PUBLIC_KOVA_API_KEY=kova_test_sk_...
