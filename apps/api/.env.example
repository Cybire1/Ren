# Ren API: copy to .env for local development. Every variable is optional except where noted;
# see src/config.ts for the full list.
# KOVA_CHAIN=tempo            # tempo (the default) or monad
KOVA_NETWORK=testnet
DATABASE_URL=postgres://localhost:5432/kova_dev
PORT=4000

# The fee payer. On Tempo it adds its signature to the fee half of what payers sign; on Monad it
# is the relayer that submits the payments people sign and pays their gas in MON.
# `pnpm --filter @kova/api setup:dev` generates one into .env.<chain> (testnet only) and funds it
# from Tempo's faucet; on Monad, fund it with testnet MON at https://faucet.monad.xyz. On mainnet
# this is a KMS key, never an env var.
# KOVA_FEE_PAYER_PRIVATE_KEY=0x...

# Moderato's fee estimates run far above mainnet's, so Tempo testnet needs a higher cap.
KOVA_MAX_SPONSORED_FEE=1000000

# A provider RPC in production (defaults to the chain's public RPC).
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Monad only: KovaRates, written by the Chainlink CRE workflow in apps/rates (Monad testnet below).
# Unset (and always on Tempo): a fixed reference table, labelled as such in the app.
# KOVA_RATES_ADDRESS=0xb5322DC6d6AA938C50859f0f0e2DF7b6Da4C9e8e

# The sites shops may sign in from with their wallet (EIP-4361). Defaults to mykova.app plus
# localhost outside production.
# KOVA_SIGN_IN_DOMAINS=localhost:3000

# Shared with the web app so rate limits count visitors, not the web server. 32+ characters.
# KOVA_PROXY_SECRET=

# Optional features:
# ANTHROPIC_API_KEY=        # "Snap your menu" (reads a menu photo into catalogue items), or
# DEEPSEEK_API_KEY=         # DeepSeek instead; KOVA_MENU_PROVIDER picks one when both are set
# DUFFEL_API_KEY=           # Ren Travel: flights and hotels (a duffel_test_ key for test mode)
# TYPESAFE_API_KEY=         # Jev: spending categories and order-note flags

# Monad only (off on Tempo): Ren Cards (KOVA_CARD_COSIGNER_KEY), USSD pockets
# (KOVA_POCKET_MASTER_KEY, KOVA_USSD_CALLBACK_SECRET, AT_*), Ramp top-ups and cash-out
# (RAMP_HOST_API_KEY) and deposits from other chains (AURORA_INTENTS_KEY). See src/config.ts.
