# Kova API — copy to .env for local development
KOVA_NETWORK=testnet
DATABASE_URL=postgres://localhost:5432/kova_dev

# Generated by `pnpm setup:dev` on testnet. On mainnet the fee payer is a KMS key.
# KOVA_FEE_PAYER_PRIVATE_KEY=0x...

# Moderato's fee estimates run far above mainnet's, so testnet needs a higher cap.
KOVA_MAX_SPONSORED_FEE=1000000
