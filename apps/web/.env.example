# The Kova API this site talks to. Every call is made from this server: the browser never
# sees a key. Shops sign in with their own secret key, sealed in an encrypted cookie.
KOVA_API_URL=http://localhost:4000

# The API base shown in the Developers quickstart, if different from KOVA_API_URL.
# KOVA_PUBLIC_API_URL=https://api.example.com

# Encrypts the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=change-me

# Optional: a shop key for "Explore the demo shop". Leave unset to hide the demo.
# DEMO_API_KEY=kova_test_sk_...

# Optional: this site's public origin, used in pay links. Defaults to the request's host.
# PUBLIC_URL=https://kova.example.com
