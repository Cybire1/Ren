# The Kova API this site talks to. Every call is made from this server: the browser never
# sees a key. Shops sign in with their own secret key, sealed in an encrypted cookie.
KOVA_API_URL=http://localhost:4000

# The API base shown in the Developers quickstart, if different from KOVA_API_URL.
# KOVA_PUBLIC_API_URL=https://api.example.com

# Encrypts the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=change-me

# Optional: a shop key for "Explore the demo shop". Leave unset to hide the demo.
# DEMO_API_KEY=kova_test_sk_...

# Optional: this site's public origin, used in pay links. Defaults to the request's host.
# PUBLIC_URL=https://kova.example.com

# The chain this deployment runs on: tempo (the default) or monad. Picked at build time.
# NEXT_PUBLIC_KOVA_CHAIN=tempo
# testnet or mainnet.
KOVA_NETWORK=testnet
# The passkey's domain (its WebAuthn RP ID). mykova.app in production; for local passkeys, localhost.
NEXT_PUBLIC_KOVA_PASSKEY_DOMAIN=localhost
# Privy, for paying and signing in with email or Google. Unset: those options are hidden.
# PRIVY_APP_ID=
# The same 32+ character secret as the API's KOVA_PROXY_SECRET.
# KOVA_PROXY_SECRET=
# Served in /.well-known/apple-app-site-association, so the iOS apps share this site's passkeys.
# Comma-separated; unset, both Apple teams and both apps (Ren on Tempo, Ren on Monad) are listed.
# APPLE_TEAM_ID=R38YN743Q6,5N8DU2A9WH
# KOVA_IOS_BUNDLE_IDS=xyz.kova.pay,xyz.kova.pay.monad
