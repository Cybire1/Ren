{
  "name": "@kova/tempo",
  "version": "0.1.0",
  "description": "Tempo primitives for Kova: networks, tokens, memos, payments, card signatures",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "ox": "0.14.45",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
