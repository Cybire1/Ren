  "html": "<div style=\"position: relative; width: 1012px; height: 638px; box-sizing: border-box; overflow: hidden; border-radius: 40px; background: #f1efea; font-family: Manrope, system-ui, sans-serif; color: #0b1a1d\">\n\n<div style=\"position: absolute; left: 0; top: 52px; width: 1012px; height: 100px; background: #0b1a1d\"></div>\n\n<div style=\"position: absolute; left: 60px; top: 196px; width: 500px; height: 74px; box-sizing: border-box; display: flex; align-items: center; padding-left: 22px; background: #faf9f5; border: 3px solid #0b1a1d; border-radius: 12px\">\n<span style=\"font-family: Caveat, cursive; font-weight: 700; font-size: 38px; transform: rotate(-3deg)\">Kovi was here</span>\n</div>\n\n<div style=\"position: absolute; left: 60px; top: 312px; width: 520px; display: flex; flex-direction: column; gap: 14px\">\n<div style=\"font-weight: 800; font-size: 38px; letter-spacing: -1px; line-height: 1.1\">Tap it on any Kova till, or scan to open your wallet.</div>\n<div style=\"font-weight: 800; font-size: 30px; color: #b44a3e\">mykova.app</div>\n<div style=\"font-weight: 500; font-size: 15px; line-height: 1.45; color: #3b4a4d\">Your dollars live in your Kova wallet, on Monad. This card is only a way in: your passkey stays on your phone, and no one can spend without it.</div>\n</div>\n\n<div style=\"position: absolute; right: 60px; top: 196px; display: flex; flex-direction: column; align-items: center; gap: 10px\">\n<div style=\"width: 236px; height: 236px; box-sizing: border-box; padding: 22px; background: #faf9f5; border: 4px solid #0b1a1d; border-radius: 24px\">\n<img src=\"{{art}}qr-ink.png\" alt=\"QR code for mykova.app\" style=\"width: 184px; height: 184px; image-rendering: pixelated\">\n</div>\n<div style=\"font-family: Caveat, cursive; font-weight: 700; font-size: 32px; transform: rotate(-3deg)\">scan me</div>\n</div>\n\n<img src=\"{{art}}kovi-peek.png\" alt=\"Kovi peeking over the edge\" style=\"position: absolute; right: 330px; bottom: -6px; width: 200px; height: 100px\">\n\n</div>"
